# LifeOS Environment Configuration Template
# Duplicate this file as .env and fill in your local credentials.

# Django Security and Core Settings
SECRET_KEY=your-secret-key-here-must-be-random-and-secure
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL Database Configuration
DB_NAME=lifeos_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Timezone and Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us
